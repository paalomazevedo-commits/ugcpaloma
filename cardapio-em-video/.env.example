# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Nunca envie o .env.local para o GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Chave secreta: só o servidor usa. Nunca coloque em código que vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
